# Keep the build context small and stop host-built artefacts from leaking into
# the image. Everything the image needs is either declared in package.json or
# produced by a build stage.

# Dependencies — reinstalled per stage from the lockfile
node_modules/
client/node_modules/

# Build outputs — regenerated by the build stages.
# public/ is deliberately NOT excluded: public/index.html is the webpack HTML
# template and the client-build stage needs it. The generated bundle is
# overwritten by that stage, so a stale committed copy cannot reach the image.
dist/
coverage/
*.tsbuildinfo

# Tests and tooling — the runtime image runs neither
tests/
.husky/
eslint.config.js
.lintstagedrc.json
commitlint.config.js
vitest.config.mts
.prettierrc
.prettierignore

# Local environment / secrets
.env
.env.*
*.pem
*.crt
*.key

# VCS and editor
.git/
.gitignore
.DS_Store

# Docs
*.md

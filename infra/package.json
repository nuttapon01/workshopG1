{
  "name": "pointhub-infra",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK infrastructure for PointHub — ECR, VPC, RDS PostgreSQL 15, ECS Fargate",
  "bin": {
    "pointhub-infra": "bin/pointhub.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "test": "vitest run",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "cdk": "cdk",
    "bootstrap": "cdk bootstrap",
    "deploy:foundation": "cdk deploy \"*PointhubEcr\" \"*PointhubNetwork\" --require-approval never",
    "deploy:data": "cdk deploy \"*PointhubData\" --require-approval never",
    "deploy:app": "cdk deploy \"*PointhubApp\" --require-approval never",
    "deploy:cicd": "cdk deploy \"*PointhubCicdRole\" --require-approval never",
    "destroy": "cdk destroy --all --force",
    "format": "prettier --write \"{bin,lib,lambda,test}/**/*.ts\"",
    "format:check": "prettier --check \"{bin,lib,lambda,test}/**/*.ts\""
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "3.1114.0",
    "@types/node": "20.11.5",
    "@types/pg": "8.15.6",
    "@types/source-map-support": "0.5.10",
    "aws-cdk": "2.1138.0",
    "esbuild": "0.25.12",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "aws-cdk-lib": "2.266.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1",
    "pg": "8.23.0"
  }
}
